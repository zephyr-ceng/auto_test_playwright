{
  "info": {
    "name": "上传附件到设计患者",
    "description": "Apifox 可直接导入的独立模块。按顺序执行：登录 -> 查询目标患者 -> 初始化上传 -> 上传分片 -> 完成上传 -> 绑定附件到患者 -> 验证绑定结果。\n\n默认目标页面：http://localhost:3000/createDesign?patientID=695029440574758912\n默认文件变量按 data/dicom/wujia/SLZ+000.dcm 设置。上传分片接口需要在 Apifox 的 form-data 文件字段 content 中手动选择同一个 DICOM 文件。\n\n注意：绑定接口不要传 treatmentID 空字符串或 0；本模块不传 treatmentID。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01 登录",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/login_by_username",
        "description": "使用本地账号登录，并提取 Set-Cookie 到 sessionCookie。后续接口会显式带 Cookie: {{sessionCookie}}。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"returnToken\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function setVar(key, value) {",
              "  if (value === undefined || value === null || value === '') return;",
              "  if (pm.collectionVariables) pm.collectionVariables.set(key, String(value));",
              "  if (pm.environment) pm.environment.set(key, String(value));",
              "}",
              "const body = pm.response.json();",
              "pm.test('HTTP 状态码为 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test('登录业务 code 为 0', function () { pm.expect(Number(body.code)).to.eql(0); });",
              "const setCookie = pm.response.headers.get('Set-Cookie') || pm.response.headers.get('set-cookie');",
              "if (setCookie) setVar('sessionCookie', setCookie.split(';')[0]);",
              "if (body.data) {",
              "  setVar('userId', body.data.userID || body.data.userId);",
              "  setVar('tenantId', body.data.tenantID || body.data.tenantId);",
              "  setVar('accountId', body.data.accountID || body.data.accountId);",
              "  setVar('token', body.data.token);",
              "}"
            ]
          }
        }
      ]
    },
    {
      "name": "02 查询目标患者详情 [command=13007]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "command",
            "value": "13007"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{gatewayUrl}}",
        "description": "确认 patientID 对应患者存在，并返回 files/medicalRecords。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{patientID}}\",\n  \"needFiles\": true,\n  \"needMedicalRecords\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('HTTP 状态码为 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test('查询患者业务 code 为 0', function () { pm.expect(Number(body.code)).to.eql(0); });",
              "pm.test('患者 ID 匹配', function () { pm.expect(String(body.data.id)).to.eql(String(pm.collectionVariables.get('patientID') || pm.environment.get('patientID'))); });"
            ]
          }
        }
      ]
    },
    {
      "name": "03 初始化附件上传 [command=11001]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "command",
            "value": "11001"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{gatewayUrl}}",
        "description": "初始化单分片上传。fileSize/fileMd5 默认对应 data/dicom/wujia/SLZ+000.dcm；如换文件，需要同步修改 fileName、fileSize、fileMd5。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"entryPoint\": 1,\n  \"fileName\": \"{{fileName}}\",\n  \"fileSize\": {{fileSize}},\n  \"md5\": \"{{fileMd5}}\",\n  \"frontendOssUpload\": false,\n  \"partsInfo\": [\n    {\n      \"partID\": {{partID}},\n      \"partMD5\": \"{{fileMd5}}\",\n      \"partSize\": {{fileSize}}\n    }\n  ],\n  \"extra\": {\n    \"files\": [\n      {\n        \"filename\": \"{{fileName}}\",\n        \"offset\": 0,\n        \"length\": {{fileSize}}\n      }\n    ],\n    \"compressVersion\": 0,\n    \"cryptoVersion\": 0\n  }\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function setVar(key, value) {",
              "  if (value === undefined || value === null || value === '') return;",
              "  if (pm.collectionVariables) pm.collectionVariables.set(key, String(value));",
              "  if (pm.environment) pm.environment.set(key, String(value));",
              "}",
              "const body = pm.response.json();",
              "pm.test('HTTP 状态码为 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test('初始化上传业务 code 为 0', function () { pm.expect(Number(body.code)).to.eql(0); });",
              "pm.test('返回 fileKey', function () { pm.expect(body.data.fileKey).to.be.ok; });",
              "setVar('fileKey', body.data.fileKey);",
              "if (body.data.frontendOssUploadPartsInfo && body.data.frontendOssUploadPartsInfo[0]) {",
              "  setVar('ossPartFileKey', body.data.frontendOssUploadPartsInfo[0].fileKey);",
              "}",
              "if (body.data.partOssKeyPrefix) setVar('partOssKeyPrefix', body.data.partOssKeyPrefix);"
            ]
          }
        }
      ]
    },
    {
      "name": "04 上传附件分片",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{baseUrl}}/upload_part",
        "description": "Body 使用 form-data。content 字段需在 Apifox 中手动选择与 fileName/fileSize/fileMd5 对应的本地 DICOM 文件。",
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "partID",
              "value": "{{partID}}",
              "type": "text"
            },
            {
              "key": "content",
              "type": "file",
              "src": "",
              "description": "选择本地 DICOM 文件，例如 data/dicom/wujia/SLZ+000.dcm"
            },
            {
              "key": "fileKey",
              "value": "{{fileKey}}",
              "type": "text"
            }
          ]
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const fileKey = pm.collectionVariables.get('fileKey') || pm.environment.get('fileKey');",
              "pm.test('已存在 fileKey', function () { pm.expect(fileKey).to.be.ok; });",
              "if (!fileKey) throw new Error('缺少 fileKey，请先执行 03 初始化附件上传');"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('HTTP 状态码为 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test('上传分片业务 code 为 0', function () { pm.expect(Number(body.code)).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "05 完成附件上传 [command=11002]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "command",
            "value": "11002"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{gatewayUrl}}",
        "description": "通知服务端所有分片已经上传完成。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"fileKey\": \"{{fileKey}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('HTTP 状态码为 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test('完成上传业务 code 为 0', function () { pm.expect(Number(body.code)).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "06 绑定附件到患者 [command=13005]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "command",
            "value": "13005"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{gatewayUrl}}",
        "description": "将已上传附件绑定到 createDesign 页面中的 patientID。不要传 treatmentID 空字符串或 0。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"patientID\": \"{{patientID}}\",\n  \"fileKey\": \"{{fileKey}}\",\n  \"tags\": [\n    \"{{fileTag}}\"\n  ],\n  \"name\": \"{{fileName}}\",\n  \"type\": \"{{fileType}}\",\n  \"params\": \"{}\",\n  \"jawType\": \"{{jawType}}\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "pm.test('HTTP 状态码为 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test('绑定附件业务 code 为 0', function () { pm.expect(Number(body.code)).to.eql(0); });"
            ]
          }
        }
      ]
    },
    {
      "name": "07 验证患者附件已绑定 [command=13007]",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "command",
            "value": "13007"
          },
          {
            "key": "Cookie",
            "value": "{{sessionCookie}}"
          }
        ],
        "url": "{{gatewayUrl}}",
        "description": "再次查询患者详情，验证 files 中包含本次上传的 fileKey。",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"{{patientID}}\",\n  \"needFiles\": true,\n  \"needMedicalRecords\": true\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const body = pm.response.json();",
              "const expectedFileKey = pm.collectionVariables.get('fileKey') || pm.environment.get('fileKey');",
              "pm.test('HTTP 状态码为 2xx', function () { pm.expect(pm.response.code).to.be.within(200, 299); });",
              "pm.test('验证查询业务 code 为 0', function () { pm.expect(Number(body.code)).to.eql(0); });",
              "pm.test('患者 files 包含本次 fileKey', function () {",
              "  const files = body.data && Array.isArray(body.data.files) ? body.data.files : [];",
              "  const found = files.some(function (file) { return String(file.fileKey || file.FileKey || file.key || file.ID || file.id) === String(expectedFileKey); });",
              "  pm.expect(found, 'fileKey=' + expectedFileKey).to.eql(true);",
              "});"
            ]
          }
        }
      ]
    }
  ],
  "variable": [
