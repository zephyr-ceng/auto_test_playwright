        "description": "接口名称：loginByUserName\n接口描述：使用 username/password 登录，可通过 returnToken 要求后端返回 token。\n分组：登录认证\n代码来源：src/api/login/index.ts\nReq:\n{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"returnToken\": false\n}\nRes:\n{\n  \"code\": 0,\n  \"data\": {\n    \"accountID\": \"account-id\",\n    \"name\": \"管理员\",\n    \"tenantID\": \"tenant-id\",\n    \"tenantType\": \"clinic\",\n    \"userID\": \"user-id\",\n    \"username\": \"admin\",\n    \"token\": \"\"\n  },\n  \"message\": \"success\"\n}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"returnToken\": false\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "response": [],
      "event": [
        {
          "listen": "prerequest",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function getScopeValue(key) {",
              "  if (pm.environment && pm.environment.get(key)) return pm.environment.get(key);",
              "  if (pm.globals && pm.globals.get(key)) return pm.globals.get(key);",
              "  if (pm.collectionVariables && pm.collectionVariables.get(key)) return pm.collectionVariables.get(key);",
              "  return \"\";",
              "}",
              "function getIterationValue(columnName) {",
              "  if (!pm.iterationData || !pm.iterationData.get) return undefined;",
              "  var value = pm.iterationData.get(columnName);",
              "  return value === null ? undefined : value;",
              "}",
              "function hasIterationColumn(columnName) {",
              "  return getIterationValue(columnName) !== undefined;",
              "}",
              "function normalizeIterationValue(rawValue, mapping) {",
              "  var value = rawValue;",
              "  if ((value === \"\" || value === undefined || value === null) && mapping.fallbackOnEmpty) {",
              "    if (mapping.fallbackVariable) value = getScopeValue(mapping.fallbackVariable);",
              "    else if (Object.prototype.hasOwnProperty.call(mapping, \"fallbackValue\")) value = mapping.fallbackValue;",
              "  }",
              "  if (value === undefined || value === null) return value;",
              "  if (mapping.type === \"boolean\") {",
              "    if (typeof value === \"boolean\") return value;",
              "    return String(value).toLowerCase() === \"true\";",
              "  }",
              "  if (mapping.type === \"dateMillis\") {",
              "    if (value === \"\") return value;",
              "    var parsedDate = Date.parse(String(value));",
              "    if (!Number.isNaN(parsedDate)) return parsedDate;",
              "    var numberDate = Number(value);",
              "    return Number.isNaN(numberDate) ? value : numberDate;",
              "  }",
              "  if (mapping.type === \"gender\") {",
              "    if (value === \"\") return value;",
              "    if (String(value).includes(\"女\")) return 2;",
              "    if (String(value).includes(\"男\")) return 1;",
              "    var genderNumber = Number(value);",
              "    return Number.isNaN(genderNumber) ? value : genderNumber;",
              "  }",
              "  if (mapping.type === \"number\") {",
              "    var numericValue = Number(value);",
              "    return Number.isNaN(numericValue) ? value : numericValue;",
              "  }",
              "  return String(value);",
              "}",
              "function patchJsonBodyByIteration(mappings) {",
              "  if (!pm.request.body || !pm.request.body.raw) return;",
              "  var hasDataDrivenColumn = mappings.some(function(mapping) { return hasIterationColumn(mapping.column); });",
              "  if (!hasDataDrivenColumn) return;",
              "  try {",
              "    var body = JSON.parse(pm.request.body.raw);",
              "    mappings.forEach(function(mapping) {",
              "      var rawValue = getIterationValue(mapping.column);",
              "      if (rawValue === undefined) return;",
              "      var value = normalizeIterationValue(rawValue, mapping);",
              "      if ((value === undefined || value === null || value === \"\") && !mapping.allowEmpty) return;",
              "      body[mapping.field] = value;",
              "    });",
              "    pm.request.body.update(JSON.stringify(body, null, 2));",
              "  } catch (error) {",
              "    console.warn(\"CSV 数据驱动请求体写入失败\", error);",
              "  }",
              "}",
              "patchJsonBodyByIteration([{\"column\":\"账号\",\"field\":\"username\",\"allowEmpty\":true},{\"column\":\"密码\",\"field\":\"password\",\"allowEmpty\":true},{\"column\":\"returnToken\",\"field\":\"returnToken\",\"type\":\"boolean\"}]);"
            ]
          }
        },
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "function setScopeValue(key, value) {",
              "  if (value === undefined || value === null || value === \"\") return;",
