    "/baseUrl/login_by_username": {
      "post": {
        "summary": "用户名密码登录",
        "deprecated": false,
        "description": "接口名称：loginByUserName\n接口描述：使用 username/password 登录，可通过 returnToken 要求后端返回 token。\n分组：登录认证\n代码来源：src/api/login/index.ts\nReq:\n{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\",\n  \"returnToken\": false\n}\nRes:\n{\n  \"code\": 0,\n  \"data\": {\n    \"accountID\": \"account-id\",\n    \"name\": \"管理员\",\n    \"tenantID\": \"tenant-id\",\n    \"tenantType\": \"clinic\",\n    \"userID\": \"user-id\",\n    \"username\": \"admin\",\n    \"token\": \"\"\n  },\n  \"message\": \"success\"\n}",
        "tags": [],
        "parameters": [
          {
            "name": "Content-Type",
            "in": "header",
            "description": "JSON 请求体",
            "required": true,
            "example": "application/json",
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "username": {
                    "type": "string"
                  },
                  "password": {
                    "type": "string"
                  },
                  "returnToken": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "username",
                  "password",
                  "returnToken"
                ]
              },
              "example": {
                "username": "{{username}}",
                "password": "{{password}}",
                "returnToken": false
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {}
                }
              }
            },
            "headers": {}
          }
        },
        "security": []
      }
    },
